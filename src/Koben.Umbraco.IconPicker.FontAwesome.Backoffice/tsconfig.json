{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": false,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"experimentalDecorators": true
	},
	"include": ["src/**/*.ts", "vite.config.ts"]
}
