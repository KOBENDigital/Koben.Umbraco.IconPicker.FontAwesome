<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>Koben.Umbraco.IconPicker.FontAwesome</PackageId>
		<Description>Umbraco backoffice package for the Font Awesome Icon Picker plugin</Description>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);BuildBackofficeAssets</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Koben.Umbraco.IconPicker.FontAwesome.Core\Koben.Umbraco.IconPicker.FontAwesome.Core.csproj" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="pack\_._" Pack="true" PackagePath="lib\net10.0\" />
		<None Include="build\Koben.Umbraco.IconPicker.FontAwesome.targets" Pack="true" PackagePath="build\Koben.Umbraco.IconPicker.FontAwesome.targets" />
		<None Include="build\Koben.Umbraco.IconPicker.FontAwesome.targets" Pack="true" PackagePath="buildTransitive\Koben.Umbraco.IconPicker.FontAwesome.targets" />
		<None Include="public\umbraco-package.json" Pack="true" PackagePath="App_Plugins\Koben.Umbraco.IconPicker.FontAwesome\" />
	</ItemGroup>

	<Target Name="BuildBackofficeAssets">
		<Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<ItemGroup>
			<TfmSpecificPackageFile Include="dist\**\*" Exclude="dist\umbraco-package.json">
				<PackagePath>App_Plugins\Koben.Umbraco.IconPicker.FontAwesome\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
			</TfmSpecificPackageFile>
		</ItemGroup>
	</Target>

</Project>

