<Project>
	<PropertyGroup>
		<Title>Koben.Umbraco.IconPicker.FontAwesome</Title>
		<Authors>Koben Digital</Authors>
		<Company>Koben Digital</Company>
		<Description>A Font Awesome Free and Pro icon picker property editor for Umbraco 18.</Description>
		<RepositoryUrl>https://github.com/KOBENDigital/Koben.Umbraco.IconPicker.FontAwesome</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Umbraco;Font Awesome;Icon Picker;Property Editor;Backoffice</PackageTags>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Local-development fallback; release.yml overrides this with the Git tag version when packaging. -->
		<Version>18.0.0</Version>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>
</Project>
